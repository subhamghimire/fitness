NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
APP_NAME=backend

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_HOST_ADDRESS=db.<your-supabase-project-ref>.supabase.co
DATABASE_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-db-password
DATABASE_URL=postgresql://postgres:your-supabase-db-password@db.<your-supabase-project-ref>.supabase.co:5432/postgres

# ─── Supabase Project Keys ────────────────────────────────────────────────────
# Find these at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT (custom auth) ────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# ─── Redis ────────────────────────────────────────────────────────────────────
# Backs two things: the notification pipeline's background job queue (BullMQ) and
# cross-instance WebSocket fan-out (Socket.IO redis-adapter). Same URL for both.
REDIS_URL=redis://localhost:6379

# ─── Notification pipeline tuning (optional, shown with defaults) ─────────────
# NOTIFICATION_RELAY_BATCH_SIZE=50
# NOTIFICATION_RELAY_POLL_MS=2000
# NOTIFICATION_EVENT_JOB_ATTEMPTS=5
