NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
APP_NAME=backend

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_HOST_ADDRESS=db.<your-supabase-project-ref>.supabase.co
DATABASE_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-db-password
DATABASE_URL=postgresql://postgres:your-supabase-db-password@db.<your-supabase-project-ref>.supabase.co:5432/postgres

# ─── Supabase Project Keys ────────────────────────────────────────────────────
# Find these at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT (custom auth) ────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
