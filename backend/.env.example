NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
APP_NAME=fitness-backend

# ─── Database (Supabase or Local PostgreSQL) ──────────────────────────────────
# For local Postgres, use these fields:
DATABASE_HOST_ADDRESS=localhost
DATABASE_PORT=5432
POSTGRES_DB=fitness_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# If using Supabase (requires SSL), set DATABASE_URL instead:
# DATABASE_URL=postgresql://postgres:your-password@db.<project-ref>.supabase.co:5432/postgres

# ─── Supabase Project Keys (optional) ─────────────────────────────────────────
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=fitness-super-secure-jwt-secret-key-development-2026
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_IDS=your-web-client-id,your-android-client-id,your-ios-client-id
