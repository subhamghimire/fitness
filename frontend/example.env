# Production / Preview API (deployed backend on Render)
EXPO_PUBLIC_API_URL=https://<your-render-service>.onrender.com/api/v1

# Local development — Android Emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Local development — iOS Simulator / Web
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth (optional)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
